# ---------------------------------------------------------------- Line endings
# Normalise every text file to LF in the repository and on checkout. Git for
# Windows defaults to core.autocrlf=true, which rewrites tools/*.sh to CRLF on
# clone; bash then fails with `bad interpreter: /usr/bin/env bash^M`, an error
# that points at the shell rather than at the checkout that caused it.
* text=auto eol=lf

# Batch files are the exception -- cmd.exe wants CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# ---------------------------------------------------------------- Git LFS
# Binary assets go to LFS. These files are GENERATED (tools/gen-art.mjs,
# gen-audio.mjs, gen-music.mjs) and regenerating them is the normal workflow --
# git stores a whole new blob for a compressed format every time, so history
# would grow by the full asset size on every palette tweak. It also sets the
# pattern before a fork commits a real sprite sheet.
#
# Unity's .meta files are TEXT and must stay out of LFS: Unity reads them
# constantly and they need to diff and merge normally.
*.png  filter=lfs diff=lfs merge=lfs -text
*.jpg  filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
*.gif  filter=lfs diff=lfs merge=lfs -text
*.psd  filter=lfs diff=lfs merge=lfs -text
*.wav  filter=lfs diff=lfs merge=lfs -text
*.ogg  filter=lfs diff=lfs merge=lfs -text
*.mp3  filter=lfs diff=lfs merge=lfs -text
*.ttf  filter=lfs diff=lfs merge=lfs -text
*.otf  filter=lfs diff=lfs merge=lfs -text

# Unity text assets — never LFS.
*.meta       text eol=lf
*.unity      text eol=lf
*.asset      text eol=lf
*.prefab     text eol=lf
